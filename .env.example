# PostgreSQL 连接串（数据库需已创建；本地开发可用 deploy 里独立容器，见 README）
DATABASE_URL=postgres://judge:judge@localhost:5544/mango_judge_dev

# 管理员密码：至少 12 位，生产必须用随机值（openssl rand -base64 24），不提供默认密码
ADMIN_PASSWORD=

# 对外基地址：影响 cookie Secure 标记与管理端生成的评委/大屏邀请链接
PUBLIC_BASE_URL=http://localhost:3200

# API 监听端口
PORT=3200

# 前端构建注入：当前部署版本的源码地址（AGPL 网络部署源码提供，见 LICENSING.md）
VITE_JUDGING_SOURCE_URL=

# 评委/大屏邀请链接前缀；不填时用 PUBLIC_BASE_URL
# INVITE_BASE_URL=
